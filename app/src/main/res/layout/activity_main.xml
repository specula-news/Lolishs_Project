<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/lumen_bg">

	<!-- Artwork of the focused / featured item, faded behind the content -->
	<ImageView
		android:id="@+id/backdrop"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:alpha="0"
		android:importantForAccessibility="no"
		android:scaleType="centerCrop" />

	<View
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="@drawable/scrim_hero" />

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="horizontal">

		<!-- Sidebar, like Li'Server -->
		<LinearLayout
			android:id="@+id/sidebar"
			android:layout_width="250dp"
			android:layout_height="match_parent"
			android:background="@color/lumen_sidebar"
			android:orientation="vertical"
			android:paddingStart="14dp"
			android:paddingTop="26dp"
			android:paddingEnd="14dp"
			android:paddingBottom="22dp">

			<LinearLayout
				android:id="@+id/brand"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				android:paddingStart="6dp">

				<ImageView
					android:layout_width="38dp"
					android:layout_height="38dp"
					android:importantForAccessibility="no"
					android:src="@drawable/logo" />

				<TextView
					android:id="@+id/brand_text"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginStart="12dp"
					android:fontFamily="@font/fraunces_black_italic"
					android:maxLines="1"
					android:textColor="@color/lumen_accent"
					android:textSize="22sp" />
			</LinearLayout>

			<ScrollView
				android:layout_width="match_parent"
				android:layout_height="0dp"
				android:layout_marginTop="24dp"
				android:layout_weight="1"
				android:scrollbars="none">

				<LinearLayout
					android:id="@+id/nav_list"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical" />
			</ScrollView>

			<LinearLayout
				android:id="@+id/nav_bottom"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical" />
		</LinearLayout>

		<View
			android:layout_width="1dp"
			android:layout_height="match_parent"
			android:background="@color/lumen_divider" />

		<FrameLayout
			android:id="@+id/content"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="1" />
	</LinearLayout>

	<TextView
		android:id="@+id/toast"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="bottom|center_horizontal"
		android:layout_marginBottom="40dp"
		android:alpha="0"
		android:background="@drawable/bg_hud"
		android:fontFamily="@font/dmsans_medium"
		android:paddingStart="20dp"
		android:paddingTop="12dp"
		android:paddingEnd="20dp"
		android:paddingBottom="12dp"
		android:textColor="@color/lumen_text"
		android:textSize="16sp" />
</FrameLayout>
