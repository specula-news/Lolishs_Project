<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@drawable/bg_home">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="horizontal"
		android:paddingStart="64dp"
		android:paddingTop="@dimen/overscan_v"
		android:paddingEnd="@dimen/overscan_h"
		android:paddingBottom="@dimen/overscan_v">

		<!-- Brand / status column -->
		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="0.42"
			android:gravity="center_vertical"
			android:orientation="vertical"
			android:paddingEnd="48dp">

			<ImageView
				android:layout_width="88dp"
				android:layout_height="88dp"
				android:importantForAccessibility="no"
				android:src="@drawable/logo" />

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp"
				android:fontFamily="sans-serif-medium"
				android:letterSpacing="-0.01"
				android:text="Lumen Player"
				android:textColor="@color/lumen_text"
				android:textSize="40sp" />

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:text="@string/app_tagline"
				android:textColor="@color/lumen_text_2"
				android:textSize="18sp" />

			<TextView
				android:id="@+id/status"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="32dp"
				android:background="@drawable/bg_hud"
				android:lineSpacingMultiplier="1.3"
				android:padding="20dp"
				android:textColor="@color/lumen_text_2"
				android:textSize="15sp" />

			<TextView
				android:id="@+id/version"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				android:textColor="@color/lumen_text_3"
				android:textSize="13sp" />
		</LinearLayout>

		<!-- Settings column -->
		<ScrollView
			android:id="@+id/settings_scroll"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="0.58"
			android:fadingEdgeLength="32dp"
			android:requiresFadingEdge="vertical"
			android:scrollbars="none">

			<LinearLayout
				android:id="@+id/settings_list"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:paddingTop="24dp"
				android:paddingBottom="48dp" />
		</ScrollView>
	</LinearLayout>

	<!-- Link server overlay -->
	<FrameLayout
		android:id="@+id/link_overlay"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="#E6000000"
		android:clickable="true"
		android:visibility="gone">

		<LinearLayout
			android:layout_width="680dp"
			android:layout_height="wrap_content"
			android:layout_gravity="center"
			android:background="@drawable/bg_hud"
			android:orientation="vertical"
			android:padding="36dp">

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:fontFamily="sans-serif-medium"
				android:text="Link your Jellyfin server"
				android:textColor="@color/lumen_text"
				android:textSize="26sp" />

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="6dp"
				android:lineSpacingMultiplier="1.2"
				android:text="Optional. Unlocks skip intro / credits, chapters, seek thumbnails and proper subtitle names. Playback, resume and watched status work without it."
				android:textColor="@color/lumen_text_2"
				android:textSize="14sp" />

			<EditText
				android:id="@+id/server_url"
				android:layout_width="match_parent"
				android:layout_height="56dp"
				android:layout_marginTop="22dp"
				android:background="@drawable/bg_edit"
				android:hint="http://192.168.1.10:8096"
				android:imeOptions="actionDone"
				android:importantForAutofill="no"
				android:inputType="textUri"
				android:paddingStart="18dp"
				android:paddingEnd="18dp"
				android:singleLine="true"
				android:textColor="@color/lumen_text"
				android:textColorHint="@color/lumen_text_3"
				android:textSize="18sp" />

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="18dp"
				android:orientation="horizontal">

				<TextView
					android:id="@+id/btn_quick_connect"
					style="@style/Lumen.Pill"
					android:text="Quick Connect" />

				<TextView
					android:id="@+id/btn_password"
					style="@style/Lumen.Pill"
					android:layout_marginStart="12dp"
					android:text="Username &amp; password" />

				<TextView
					android:id="@+id/btn_cancel_link"
					style="@style/Lumen.Pill"
					android:layout_marginStart="12dp"
					android:text="Cancel" />
			</LinearLayout>

			<LinearLayout
				android:id="@+id/password_group"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="18dp"
				android:orientation="vertical"
				android:visibility="gone">

				<EditText
					android:id="@+id/username"
					android:layout_width="match_parent"
					android:layout_height="56dp"
					android:background="@drawable/bg_edit"
					android:hint="Username"
					android:importantForAutofill="no"
					android:inputType="text"
					android:paddingStart="18dp"
					android:paddingEnd="18dp"
					android:singleLine="true"
					android:textColor="@color/lumen_text"
					android:textColorHint="@color/lumen_text_3"
					android:textSize="18sp" />

				<EditText
					android:id="@+id/password"
					android:layout_width="match_parent"
					android:layout_height="56dp"
					android:layout_marginTop="10dp"
					android:background="@drawable/bg_edit"
					android:hint="Password"
					android:imeOptions="actionDone"
					android:importantForAutofill="no"
					android:inputType="textPassword"
					android:paddingStart="18dp"
					android:paddingEnd="18dp"
					android:singleLine="true"
					android:textColor="@color/lumen_text"
					android:textColorHint="@color/lumen_text_3"
					android:textSize="18sp" />

				<TextView
					android:id="@+id/btn_sign_in"
					style="@style/Lumen.Pill"
					android:layout_marginTop="14dp"
					android:text="Sign in" />
			</LinearLayout>

			<TextView
				android:id="@+id/quick_connect_code"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="22dp"
				android:fontFamily="monospace"
				android:gravity="center"
				android:letterSpacing="0.3"
				android:textColor="@color/lumen_text"
				android:textSize="56sp"
				android:visibility="gone" />

			<TextView
				android:id="@+id/link_status"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="14dp"
				android:lineSpacingMultiplier="1.2"
				android:textColor="@color/lumen_text_2"
				android:textSize="15sp" />
		</LinearLayout>
	</FrameLayout>
</FrameLayout>
