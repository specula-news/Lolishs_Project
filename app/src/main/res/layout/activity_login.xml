<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/lumen_bg">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="horizontal"
		android:paddingStart="80dp"
		android:paddingTop="48dp"
		android:paddingEnd="64dp"
		android:paddingBottom="48dp">

		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="0.42"
			android:gravity="center_vertical"
			android:orientation="vertical"
			android:paddingEnd="48dp">

			<ImageView
				android:layout_width="84dp"
				android:layout_height="84dp"
				android:importantForAccessibility="no"
				android:src="@drawable/logo" />

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="22dp"
				android:fontFamily="@font/fraunces_black_italic"
				android:text="@string/app_name"
				android:textColor="@color/lumen_accent"
				android:textSize="46sp" />

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="6dp"
				android:text="@string/app_tagline"
				android:textColor="@color/lumen_text_2"
				android:textSize="18sp" />

			<TextView
				android:id="@+id/server_line"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="28dp"
				android:background="@drawable/bg_chip_green"
				android:fontFamily="@font/dmsans_medium"
				android:paddingStart="14dp"
				android:paddingTop="8dp"
				android:paddingEnd="14dp"
				android:paddingBottom="8dp"
				android:textColor="@color/lumen_green"
				android:textSize="14sp" />

			<TextView
				android:id="@+id/btn_change_server"
				style="@style/Lumen.Pill"
				android:layout_marginTop="16dp"
				android:text="Change server" />
		</LinearLayout>

		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_gravity="center_vertical"
			android:layout_weight="0.58"
			android:background="@drawable/bg_surface_card"
			android:orientation="vertical"
			android:padding="36dp">

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:fontFamily="@font/fraunces_black_italic"
				android:text="Who’s watching?"
				android:textColor="@color/lumen_text"
				android:textSize="32sp" />

			<HorizontalScrollView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="18dp"
				android:clipToPadding="false"
				android:scrollbars="none">

				<LinearLayout
					android:id="@+id/users"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:clipChildren="false"
					android:orientation="horizontal"
					android:paddingTop="6dp"
					android:paddingBottom="6dp" />
			</HorizontalScrollView>

			<LinearLayout
				android:id="@+id/password_group"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="18dp"
				android:orientation="vertical"
				android:visibility="gone">

				<EditText
					android:id="@+id/username"
					android:layout_width="match_parent"
					android:layout_height="56dp"
					android:background="@drawable/bg_edit"
					android:hint="Username"
					android:importantForAutofill="no"
					android:inputType="text"
					android:paddingStart="18dp"
					android:paddingEnd="18dp"
					android:singleLine="true"
					android:textColor="@color/lumen_text"
					android:textSize="18sp" />

				<EditText
					android:id="@+id/password"
					android:layout_width="match_parent"
					android:layout_height="56dp"
					android:layout_marginTop="10dp"
					android:background="@drawable/bg_edit"
					android:hint="Password"
					android:imeOptions="actionDone"
					android:importantForAutofill="no"
					android:inputType="textPassword"
					android:paddingStart="18dp"
					android:paddingEnd="18dp"
					android:singleLine="true"
					android:textColor="@color/lumen_text"
					android:textSize="18sp" />

				<TextView
					android:id="@+id/btn_sign_in"
					style="@style/Lumen.Pill"
					android:layout_marginTop="14dp"
					android:text="Sign in" />
			</LinearLayout>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp"
				android:orientation="horizontal">

				<TextView
					android:id="@+id/btn_quick_connect"
					style="@style/Lumen.Pill"
					android:text="Quick Connect" />

				<TextView
					android:id="@+id/btn_manual"
					style="@style/Lumen.Pill"
					android:layout_marginStart="12dp"
					android:text="Type username" />
			</LinearLayout>

			<TextView
				android:id="@+id/quick_connect_code"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp"
				android:fontFamily="@font/dmsans_bold"
				android:gravity="center"
				android:letterSpacing="0.3"
				android:textColor="@color/lumen_accent"
				android:textSize="56sp"
				android:visibility="gone" />

			<TextView
				android:id="@+id/status"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="14dp"
				android:lineSpacingMultiplier="1.2"
				android:textColor="@color/lumen_text_2"
				android:textSize="15sp" />
		</LinearLayout>
	</LinearLayout>
</FrameLayout>
