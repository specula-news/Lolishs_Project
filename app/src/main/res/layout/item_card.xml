<?xml version="1.0" encoding="utf-8"?>
<!-- Poster or 16:9 card. Sizes are set in code from the Appearance settings. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="wrap_content"
	android:layout_height="wrap_content"
	android:clickable="true"
	android:focusable="true"
	android:orientation="vertical"
	android:padding="7dp">

	<FrameLayout
		android:id="@+id/card_frame"
		android:layout_width="140dp"
		android:layout_height="210dp"
		android:background="@drawable/bg_card_image"
		android:duplicateParentState="true"
		android:foreground="@drawable/card_focus">

		<TextView
			android:id="@+id/card_fallback"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:ellipsize="end"
			android:gravity="center"
			android:maxLines="4"
			android:padding="12dp"
			android:textColor="?attr/lumenText2"
			android:textSize="14sp" />

		<ImageView
			android:id="@+id/card_image"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:importantForAccessibility="no"
			android:scaleType="centerCrop" />

		<TextView
			android:id="@+id/card_rating"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="top|start"
			android:layout_margin="7dp"
			android:background="@drawable/bg_tag"
			android:drawablePadding="3dp"
			android:fontFamily="@font/dmsans_bold"
			android:paddingStart="6dp"
			android:paddingTop="2dp"
			android:paddingEnd="7dp"
			android:paddingBottom="2dp"
			android:textColor="?attr/lumenAccent"
			android:textSize="11sp"
			android:visibility="gone" />

		<TextView
			android:id="@+id/card_badge"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="top|end"
			android:layout_margin="7dp"
			android:background="@drawable/bg_badge_green"
			android:fontFamily="@font/dmsans_bold"
			android:minWidth="22dp"
			android:gravity="center"
			android:paddingStart="6dp"
			android:paddingTop="1dp"
			android:paddingEnd="6dp"
			android:paddingBottom="1dp"
			android:textColor="?attr/lumenOnFocus"
			android:textSize="11sp"
			android:visibility="gone" />

		<ProgressBar
			android:id="@+id/card_progress"
			style="@android:style/Widget.ProgressBar.Horizontal"
			android:layout_width="match_parent"
			android:layout_height="4dp"
			android:layout_gravity="bottom"
			android:layout_marginStart="8dp"
			android:layout_marginEnd="8dp"
			android:layout_marginBottom="8dp"
			android:max="1000"
			android:progressDrawable="@drawable/bg_progress_track"
			android:visibility="gone" />
	</FrameLayout>

	<TextView
		android:id="@+id/card_title"
		android:layout_width="140dp"
		android:layout_height="wrap_content"
		android:layout_marginTop="8dp"
		android:duplicateParentState="true"
		android:ellipsize="end"
		android:fontFamily="@font/dmsans_medium"
		android:maxLines="1"
		android:textColor="@color/row_text"
		android:textSize="14sp" />

	<TextView
		android:id="@+id/card_subtitle"
		android:layout_width="140dp"
		android:layout_height="wrap_content"
		android:ellipsize="end"
		android:maxLines="1"
		android:textColor="?attr/lumenText2"
		android:textSize="12sp" />
</LinearLayout>
