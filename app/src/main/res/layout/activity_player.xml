<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@android:color/black"
	android:keepScreenOn="true">

	<!-- The active engine adds its video view here. -->
	<FrameLayout
		android:id="@+id/video_container"
		android:layout_width="match_parent"
		android:layout_height="match_parent" />

	<!-- Loading card shown before the first frame -->
	<LinearLayout
		android:id="@+id/loading"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="center"
		android:gravity="center_horizontal"
		android:orientation="vertical">

		<ProgressBar
			android:layout_width="56dp"
			android:layout_height="56dp"
			android:indeterminate="true"
			android:indeterminateTint="@color/lumen_accent" />

		<TextView
			android:id="@+id/loading_title"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="20dp"
			android:fontFamily="sans-serif-medium"
			android:maxWidth="720dp"
			android:gravity="center"
			android:textColor="@color/lumen_text"
			android:textSize="22sp" />

		<TextView
			android:id="@+id/loading_detail"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="6dp"
			android:text="@string/loading"
			android:textColor="@color/lumen_text_2"
			android:textSize="15sp" />
	</LinearLayout>

	<ProgressBar
		android:id="@+id/buffering"
		android:layout_width="64dp"
		android:layout_height="64dp"
		android:layout_gravity="center"
		android:indeterminate="true"
		android:indeterminateTint="@color/lumen_accent"
		android:visibility="gone" />

	<ImageView
		android:id="@+id/center_icon"
		android:layout_width="96dp"
		android:layout_height="96dp"
		android:layout_gravity="center"
		android:alpha="0"
		android:background="@drawable/bg_hud"
		android:importantForAccessibility="no"
		android:padding="24dp"
		android:src="@drawable/ic_pause" />

	<!-- Stats for nerds -->
	<TextView
		android:id="@+id/stats"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="top|start"
		android:layout_marginStart="@dimen/overscan_h"
		android:layout_marginTop="150dp"
		android:background="@drawable/bg_hud"
		android:fontFamily="monospace"
		android:lineSpacingMultiplier="1.2"
		android:padding="16dp"
		android:textColor="@color/lumen_text"
		android:textSize="12sp"
		android:visibility="gone" />

	<!-- Top bar -->
	<LinearLayout
		android:id="@+id/top_bar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_gravity="top"
		android:background="@drawable/scrim_top"
		android:orientation="horizontal"
		android:paddingStart="@dimen/overscan_h"
		android:paddingTop="@dimen/overscan_v"
		android:paddingEnd="@dimen/overscan_h"
		android:paddingBottom="72dp">

		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:orientation="vertical">

			<TextView
				android:id="@+id/title"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:ellipsize="end"
				android:fontFamily="sans-serif-medium"
				android:maxLines="1"
				android:shadowColor="#99000000"
				android:shadowRadius="8"
				android:textColor="@color/lumen_text"
				android:textSize="30sp" />

			<TextView
				android:id="@+id/subtitle"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="2dp"
				android:ellipsize="end"
				android:maxLines="1"
				android:textColor="@color/lumen_text_2"
				android:textSize="17sp"
				android:visibility="gone" />

			<LinearLayout
				android:id="@+id/badges"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="12dp"
				android:orientation="horizontal" />
		</LinearLayout>

		<LinearLayout
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginStart="24dp"
			android:gravity="end"
			android:orientation="vertical">

			<TextView
				android:id="@+id/clock"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:fontFamily="sans-serif-light"
				android:textColor="@color/lumen_text"
				android:textSize="28sp" />

			<TextView
				android:id="@+id/ends_at"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:textColor="@color/lumen_text_2"
				android:textSize="15sp" />
		</LinearLayout>
	</LinearLayout>

	<!-- Bottom bar -->
	<LinearLayout
		android:id="@+id/bottom_bar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_gravity="bottom"
		android:background="@drawable/scrim_bottom"
		android:orientation="vertical"
		android:paddingStart="@dimen/overscan_h"
		android:paddingTop="110dp"
		android:paddingEnd="@dimen/overscan_h"
		android:paddingBottom="@dimen/overscan_v">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_vertical"
			android:orientation="horizontal">

			<TextView
				android:id="@+id/elapsed"
				android:layout_width="96dp"
				android:layout_height="wrap_content"
				android:fontFamily="sans-serif-medium"
				android:textColor="@color/lumen_text"
				android:textSize="16sp" />

			<app.lumen.player.ui.TimelineView
				android:id="@+id/timeline"
				android:layout_width="0dp"
				android:layout_height="32dp"
				android:layout_weight="1"
				android:nextFocusDown="@+id/btn_play" />

			<TextView
				android:id="@+id/remaining"
				android:layout_width="96dp"
				android:layout_height="wrap_content"
				android:fontFamily="sans-serif-medium"
				android:gravity="end"
				android:textColor="@color/lumen_text"
				android:textSize="16sp" />
		</LinearLayout>

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="18dp"
			android:gravity="center_vertical"
			android:orientation="horizontal">

			<ImageButton
				android:id="@+id/btn_play"
				style="@style/Lumen.IconButton"
				android:contentDescription="@string/pause"
				android:nextFocusUp="@id/timeline"
				android:src="@drawable/ic_pause" />

			<ImageButton
				android:id="@+id/btn_rewind"
				style="@style/Lumen.IconButton"
				android:contentDescription="@string/skip_back"
				android:nextFocusUp="@id/timeline"
				android:src="@drawable/ic_rewind" />

			<ImageButton
				android:id="@+id/btn_forward"
				style="@style/Lumen.IconButton"
				android:contentDescription="@string/skip_forward"
				android:nextFocusUp="@id/timeline"
				android:src="@drawable/ic_forward" />

			<View
				android:layout_width="1dp"
				android:layout_height="28dp"
				android:layout_marginStart="4dp"
				android:layout_marginEnd="18dp"
				android:background="@color/lumen_divider" />

			<ImageButton
				android:id="@+id/btn_subtitles"
				style="@style/Lumen.IconButton"
				android:contentDescription="@string/subtitles"
				android:nextFocusUp="@id/timeline"
				android:src="@drawable/ic_subtitles" />

			<ImageButton
				android:id="@+id/btn_audio"
				style="@style/Lumen.IconButton"
				android:contentDescription="@string/audio"
				android:nextFocusUp="@id/timeline"
				android:src="@drawable/ic_audio" />

			<ImageButton
				android:id="@+id/btn_sync"
				style="@style/Lumen.IconButton"
				android:contentDescription="@string/sync"
				android:nextFocusUp="@id/timeline"
				android:src="@drawable/ic_sync" />

			<ImageButton
				android:id="@+id/btn_chapters"
				style="@style/Lumen.IconButton"
				android:contentDescription="@string/chapters"
				android:nextFocusUp="@id/timeline"
				android:src="@drawable/ic_chapters"
				android:visibility="gone" />

			<ImageButton
				android:id="@+id/btn_settings"
				style="@style/Lumen.IconButton"
				android:contentDescription="@string/settings"
				android:nextFocusUp="@id/timeline"
				android:src="@drawable/ic_tune" />

			<ImageButton
				android:id="@+id/btn_info"
				style="@style/Lumen.IconButton"
				android:contentDescription="@string/info"
				android:nextFocusUp="@id/timeline"
				android:src="@drawable/ic_info" />

			<TextView
				android:id="@+id/focus_label"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginStart="8dp"
				android:layout_weight="1"
				android:fontFamily="sans-serif-medium"
				android:textColor="@color/lumen_text_2"
				android:textSize="15sp" />

			<TextView
				android:id="@+id/engine_label"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:textColor="@color/lumen_text_3"
				android:textSize="13sp" />
		</LinearLayout>
	</LinearLayout>

	<!-- Seek preview bubble (positioned in code above the timeline) -->
	<LinearLayout
		android:id="@+id/preview"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="bottom|start"
		android:layout_marginBottom="142dp"
		android:gravity="center_horizontal"
		android:orientation="vertical"
		android:visibility="gone">

		<ImageView
			android:id="@+id/preview_image"
			android:layout_width="256dp"
			android:layout_height="144dp"
			android:background="@drawable/bg_thumb"
			android:importantForAccessibility="no"
			android:padding="2dp"
			android:scaleType="centerCrop"
			android:visibility="gone" />

		<TextView
			android:id="@+id/preview_time"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:background="@drawable/bg_hud"
			android:fontFamily="sans-serif-medium"
			android:paddingStart="12dp"
			android:paddingTop="4dp"
			android:paddingEnd="12dp"
			android:paddingBottom="4dp"
			android:textColor="@color/lumen_text"
			android:textSize="16sp" />

		<TextView
			android:id="@+id/preview_chapter"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="4dp"
			android:maxWidth="320dp"
			android:maxLines="1"
			android:ellipsize="end"
			android:shadowColor="#CC000000"
			android:shadowRadius="6"
			android:textColor="@color/lumen_text_2"
			android:textSize="13sp"
			android:visibility="gone" />
	</LinearLayout>

	<!-- Skip intro / credits -->
	<TextView
		android:id="@+id/skip_button"
		style="@style/Lumen.Pill"
		android:layout_gravity="bottom|end"
		android:layout_marginEnd="@dimen/overscan_h"
		android:layout_marginBottom="160dp"
		android:visibility="gone" />

	<!-- Quick on-screen message (e.g. "Switched to VLC") -->
	<TextView
		android:id="@+id/toast"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="top|center_horizontal"
		android:layout_marginTop="40dp"
		android:alpha="0"
		android:background="@drawable/bg_hud"
		android:fontFamily="sans-serif-medium"
		android:paddingStart="20dp"
		android:paddingTop="12dp"
		android:paddingEnd="20dp"
		android:paddingBottom="12dp"
		android:textColor="@color/lumen_text"
		android:textSize="16sp" />

	<!-- Side panel (subtitles, audio, sync, settings, chapters) -->
	<LinearLayout
		android:id="@+id/panel"
		android:layout_width="@dimen/panel_width"
		android:layout_height="match_parent"
		android:layout_gravity="end"
		android:background="@drawable/bg_panel"
		android:orientation="vertical"
		android:paddingStart="24dp"
		android:paddingTop="36dp"
		android:paddingEnd="32dp"
		android:paddingBottom="24dp"
		android:visibility="gone">

		<TextView
			android:id="@+id/panel_title"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:fontFamily="sans-serif-medium"
			android:paddingStart="14dp"
			android:textColor="@color/lumen_text"
			android:textSize="24sp" />

		<ScrollView
			android:id="@+id/panel_scroll"
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_marginTop="18dp"
			android:layout_weight="1"
			android:fadingEdgeLength="24dp"
			android:requiresFadingEdge="vertical"
			android:scrollbars="none">

			<LinearLayout
				android:id="@+id/panel_list"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical" />
		</ScrollView>
	</LinearLayout>

	<!-- Error card -->
	<LinearLayout
		android:id="@+id/error_card"
		android:layout_width="560dp"
		android:layout_height="wrap_content"
		android:layout_gravity="center"
		android:background="@drawable/bg_hud"
		android:orientation="vertical"
		android:padding="32dp"
		android:visibility="gone">

		<TextView
			android:id="@+id/error_title"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:fontFamily="sans-serif-medium"
			android:text="Can’t play this video"
			android:textColor="@color/lumen_text"
			android:textSize="22sp" />

		<TextView
			android:id="@+id/error_message"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:lineSpacingMultiplier="1.2"
			android:textColor="@color/lumen_text_2"
			android:textSize="15sp" />

		<LinearLayout
			android:id="@+id/error_actions"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="24dp"
			android:orientation="horizontal" />
	</LinearLayout>
</FrameLayout>
