<?xml version="1.0" encoding="utf-8"?>
<!-- Round icon button on the title page: filled when focused, tinted when "on" (watched, favorite…). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
	android:enterFadeDuration="120"
	android:exitFadeDuration="160">
	<item android:state_focused="true">
		<shape android:shape="oval">
			<solid android:color="?attr/lumenAccent" />
		</shape>
	</item>
	<item android:state_selected="true">
		<shape android:shape="oval">
			<solid android:color="?attr/lumenAccentDim" />
			<stroke android:width="1.5dp" android:color="?attr/lumenAccent" />
		</shape>
	</item>
	<item>
		<shape android:shape="oval">
			<solid android:color="?attr/lumenPillIdle" />
			<stroke android:width="1dp" android:color="?attr/lumenBorder" />
		</shape>
	</item>
</selector>
