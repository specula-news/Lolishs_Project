<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android"
	android:enterFadeDuration="140"
	android:exitFadeDuration="180">
	<item android:state_focused="true">
		<shape android:shape="rectangle">
			<corners android:radius="24dp" />
			<solid android:color="@color/lumen_accent" />
		</shape>
	</item>
	<item android:state_selected="true">
		<shape android:shape="rectangle">
			<corners android:radius="24dp" />
			<solid android:color="@color/lumen_accent_dim" />
			<stroke android:width="1.5dp" android:color="@color/lumen_accent" />
		</shape>
	</item>
	<item>
		<shape android:shape="rectangle">
			<corners android:radius="24dp" />
			<solid android:color="#E61D1A16" />
			<stroke android:width="1dp" android:color="@color/lumen_border" />
		</shape>
	</item>
</selector>
