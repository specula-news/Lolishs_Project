<?xml version="1.0" encoding="utf-8"?>
<!-- Player control: frosted glass circle; focused = amber with a soft halo. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
	<item android:state_focused="true">
		<layer-list>
			<item>
				<shape android:shape="oval">
					<solid android:color="#4DF0A63A" />
				</shape>
			</item>
			<item android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp">
				<shape android:shape="oval">
					<solid android:color="@color/lumen_focus" />
				</shape>
			</item>
		</layer-list>
	</item>
	<item>
		<shape android:shape="oval">
			<solid android:color="#1FFFFFFF" />
			<stroke android:width="1dp" android:color="#33FFFFFF" />
		</shape>
	</item>
</selector>
