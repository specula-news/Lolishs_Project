<?xml version="1.0" encoding="utf-8"?>
<!-- Ring around the Home banner while one of its buttons has focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
	android:enterFadeDuration="160"
	android:exitFadeDuration="200">
	<item android:state_selected="true">
		<shape android:shape="rectangle">
			<corners android:radius="22dp" />
			<stroke android:width="3dp" android:color="?attr/lumenAccent" />
		</shape>
	</item>
	<item>
		<shape android:shape="rectangle">
			<corners android:radius="22dp" />
			<stroke android:width="1dp" android:color="?attr/lumenHairline" />
		</shape>
	</item>
</selector>
