<?xml version="1.0" encoding="utf-8"?>
<!-- Main button (Play / Resume): filled light, the theme's accent when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
	android:enterFadeDuration="140"
	android:exitFadeDuration="180">
	<item android:state_focused="true">
		<shape android:shape="rectangle">
			<corners android:radius="24dp" />
			<solid android:color="?attr/lumenAccent" />
			<stroke android:width="2dp" android:color="?attr/lumenText" />
		</shape>
	</item>
	<item>
		<shape android:shape="rectangle">
			<corners android:radius="24dp" />
			<solid android:color="@color/pill_primary_idle" />
		</shape>
	</item>
</selector>
