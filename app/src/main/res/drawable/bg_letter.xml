<?xml version="1.0" encoding="utf-8"?>
<!-- A letter in the A–Z rail: filled when focused, ringed when it is the chosen letter. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
	android:enterFadeDuration="120"
	android:exitFadeDuration="160">
	<item android:state_focused="true">
		<shape android:shape="rectangle">
			<corners android:radius="15dp" />
			<solid android:color="?attr/lumenAccent" />
		</shape>
	</item>
	<item android:state_selected="true">
		<shape android:shape="rectangle">
			<corners android:radius="15dp" />
			<solid android:color="?attr/lumenAccentDim" />
			<stroke android:width="1.5dp" android:color="?attr/lumenAccent" />
		</shape>
	</item>
	<item>
		<shape android:shape="rectangle">
			<corners android:radius="15dp" />
			<solid android:color="@android:color/transparent" />
		</shape>
	</item>
</selector>
