<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android"
	android:enterFadeDuration="140"
	android:exitFadeDuration="180">
	<item android:state_focused="true">
		<shape android:shape="oval">
			<stroke android:width="3dp" android:color="?attr/lumenAccent" />
		</shape>
	</item>
	<item>
		<shape android:shape="oval">
			<stroke android:width="1dp" android:color="?attr/lumenHairline" />
		</shape>
	</item>
</selector>
