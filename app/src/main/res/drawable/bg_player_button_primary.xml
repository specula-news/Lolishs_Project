<?xml version="1.0" encoding="utf-8"?>
<!-- Play / pause: amber ring when idle so it reads as the main button. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
	android:enterFadeDuration="140"
	android:exitFadeDuration="180">
	<item android:state_focused="true">
		<layer-list>
			<item>
				<shape android:shape="oval">
					<solid android:color="#4DF0A63A" />
				</shape>
			</item>
			<item android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp">
				<shape android:shape="oval">
					<solid android:color="@color/lumen_focus" />
				</shape>
			</item>
		</layer-list>
	</item>
	<item>
		<shape android:shape="oval">
			<solid android:color="#33F0A63A" />
			<stroke android:width="2dp" android:color="@color/lumen_accent" />
		</shape>
	</item>
</selector>
