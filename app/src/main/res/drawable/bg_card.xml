<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android"
	android:enterFadeDuration="140"
	android:exitFadeDuration="180">
	<item android:state_focused="true">
		<shape android:shape="rectangle">
			<corners android:radius="16dp" />
			<solid android:color="?attr/lumenSurface2" />
			<stroke android:width="2dp" android:color="?attr/lumenFocus" />
		</shape>
	</item>
	<item>
		<shape android:shape="rectangle">
			<corners android:radius="16dp" />
			<solid android:color="?attr/lumenSurface" />
			<stroke android:width="1dp" android:color="?attr/lumenDivider" />
		</shape>
	</item>
</selector>
