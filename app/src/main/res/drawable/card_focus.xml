<?xml version="1.0" encoding="utf-8"?>
<!-- Foreground ring drawn over posters / thumbnails when focused -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
	android:enterFadeDuration="140"
	android:exitFadeDuration="180">
	<item android:state_focused="true">
		<shape android:shape="rectangle">
			<corners android:radius="12dp" />
			<stroke android:width="4dp" android:color="?attr/lumenAccent" />
		</shape>
	</item>
	<item>
		<shape android:shape="rectangle">
			<corners android:radius="12dp" />
			<stroke android:width="1dp" android:color="?attr/lumenHairline" />
		</shape>
	</item>
</selector>
