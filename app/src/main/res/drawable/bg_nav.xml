<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android"
	android:enterFadeDuration="140"
	android:exitFadeDuration="180">
	<!-- Being moved (hold OK → Move): solid accent so it's obvious which item travels. -->
	<item android:state_activated="true">
		<shape android:shape="rectangle">
			<corners android:radius="12dp" />
			<solid android:color="@color/lumen_accent_dim" />
			<stroke android:width="3dp" android:color="@color/lumen_green" android:dashWidth="8dp" android:dashGap="4dp" />
		</shape>
	</item>
	<item android:state_focused="true">
		<shape android:shape="rectangle">
			<corners android:radius="12dp" />
			<solid android:color="@color/lumen_accent_dim" />
			<stroke android:width="2dp" android:color="@color/lumen_accent" />
		</shape>
	</item>
	<item android:state_selected="true">
		<shape android:shape="rectangle">
			<corners android:radius="12dp" />
			<solid android:color="@color/lumen_accent_dim" />
		</shape>
	</item>
	<item>
		<shape android:shape="rectangle">
			<corners android:radius="12dp" />
			<solid android:color="@android:color/transparent" />
		</shape>
	</item>
</selector>
