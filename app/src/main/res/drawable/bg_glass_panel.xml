<?xml version="1.0" encoding="utf-8"?>
<!-- The frosted pane everything sits on in the Glass theme. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
	<item>
		<shape android:shape="rectangle">
			<corners android:radius="30dp" />
			<solid android:color="#9E141716" />
			<stroke android:width="1dp" android:color="#2EFFFFFF" />
		</shape>
	</item>
	<!-- Soft top sheen, like light catching the glass -->
	<item android:bottom="200dp">
		<shape android:shape="rectangle">
			<corners android:topLeftRadius="30dp" android:topRightRadius="30dp" />
			<gradient android:angle="270" android:startColor="#14FFFFFF" android:endColor="#00FFFFFF" />
		</shape>
	</item>
</layer-list>
