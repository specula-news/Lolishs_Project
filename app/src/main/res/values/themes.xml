<?xml version="1.0" encoding="utf-8"?>
<resources>
	<style name="Theme.Lumen" parent="@android:style/Theme.DeviceDefault.NoActionBar">
		<item name="android:windowBackground">@color/lumen_bg</item>
		<item name="android:colorAccent">@color/lumen_accent</item>
		<item name="android:colorPrimary">@color/lumen_bg</item>
		<item name="android:colorPrimaryDark">@color/lumen_bg</item>
		<item name="android:statusBarColor">@color/lumen_bg</item>
		<item name="android:navigationBarColor">@color/lumen_bg</item>
		<item name="android:textColor">@color/lumen_text</item>
		<item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
	</style>

	<style name="Theme.Lumen.Player" parent="Theme.Lumen">
		<item name="android:windowBackground">@android:color/black</item>
		<item name="android:windowFullscreen">true</item>
		<item name="android:windowNoTitle">true</item>
		<item name="android:windowContentOverlay">@null</item>
	</style>

	<style name="Lumen.IconButton" parent="">
		<item name="android:layout_width">@dimen/icon_button</item>
		<item name="android:layout_height">@dimen/icon_button</item>
		<item name="android:layout_marginEnd">14dp</item>
		<item name="android:background">@drawable/bg_icon_button</item>
		<item name="android:padding">11dp</item>
		<item name="android:scaleType">fitCenter</item>
		<item name="android:focusable">true</item>
		<item name="android:clickable">true</item>
		<item name="android:tint">@color/icon_button_tint</item>
	</style>

	<style name="Lumen.Pill" parent="">
		<item name="android:layout_width">wrap_content</item>
		<item name="android:layout_height">48dp</item>
		<item name="android:background">@drawable/bg_pill</item>
		<item name="android:gravity">center</item>
		<item name="android:paddingStart">22dp</item>
		<item name="android:paddingEnd">22dp</item>
		<item name="android:textColor">@color/pill_text</item>
		<item name="android:textSize">16sp</item>
		<item name="android:fontFamily">sans-serif-medium</item>
		<item name="android:focusable">true</item>
		<item name="android:clickable">true</item>
	</style>
</resources>
